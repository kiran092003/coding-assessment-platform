# Copy to .env and fill in. `docker compose up` reads .env automatically.
#
#   cp .env.example .env
#
# Generate strong values, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# MySQL root password. Used by the mysql container and every service's DB_PASSWORD.
MYSQL_ROOT_PASSWORD=change-me

# Signing keys for access and refresh tokens. These must differ from each
# other, and anyone holding JWT_SECRET can mint an admin token — treat it
# like a password.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
